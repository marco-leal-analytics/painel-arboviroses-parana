getColor.lia <- function(x) {
if(is.na(x)){
return("white")
} else{
if(x == "Infestado"){
return("red")
}else if(x == "Não infestado"){
return("green")
}
}
}
getColor.lia(dados.maps.pr$Condição)
getColor.lia <- function(x) {
if(x == "Infestado"){
return("red")
}else if(x == "Não infestado"){
return("green")
}
}
getColor.lia(dados.maps.pr$Condição)
sapply(1:length(dados.maps.pr$Condição),FUN = function(i) getColor.lia(dados.maps.pr$Condição[i]))
getColor.lia <- function(x) {
if(str_detect(string = x,pattern = "Não")){
return("green")
}else {
return("red")
}
}
sapply(1:length(dados.maps.pr$Condição),FUN = function(i) getColor.lia(dados.maps.pr$Condição[i]))
