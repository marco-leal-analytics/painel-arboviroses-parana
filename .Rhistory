casos                                <- df1 %>% group_by(ID_MN_RESI) %>% summarise(Casos=n())  %>% rename(Codigo=ID_MN_RESI)
obitos                               <- df1 %>% filter(EVOLUCAO == 2) %>% group_by(ID_MN_RESI) %>% summarise(Obitos = n()) %>% rename(Codigo=ID_MN_RESI)
