dados.maps.pr                        <- left_join(dados.maps.pr,obitos,"Codigo")
dados.maps.pr                        <- dados.maps.pr %>% mutate(incidencia=(as.numeric(Casos)/as.numeric(`População estimada - pessoas [2019]`))*100000)
