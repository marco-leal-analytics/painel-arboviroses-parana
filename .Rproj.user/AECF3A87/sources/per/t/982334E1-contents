



library(readxl)
library(ggplot2)
library(data.table)
library(leaflet)
library(tidyverse)

dados_int_pr                     <- read_excel("dados//Dengue 15 RS.xls",sheet = "RS confirmados")
dados_int_pr                     <- dados_int_pr  %>% rename(Codigo = `CÓD. IBGE`)
dados_int_pr$Codigo             <- as.numeric(dados_int_pr$Codigo)
dados.pr                        <- readxl::read_xlsx(path = "www/dados.pr.xlsx",sheet = "Worksheet") %>% select(`Município [-]`,`Código [-]`) %>% rename(Codigo=`Código [-]`,
                                                                                                                                                         Municipio=`Município [-]`)
dados.pr$Municipio              <- tolower(rm_accent(as.character(dados.pr$Municipio)))
dados.pr$Codigo                 <- as.numeric(gsub('.{1}$', '', dados.pr$Codigo))
teste = left_join(dados.pr,df1 %>% filter(SG_UF == 41) %>% group_by(ID_MN_RESI) %>% summarise(casos=n()) %>% rename(Codigo=ID_MN_RESI))
teste$casos[is.na(teste$casos)] <- 0

dados_int_pr                    <- left_join(dados_int_pr,teste,"Codigo")

dados_int_pr                    <<- dados_int_pr %>% mutate('2020' = casos)

dados_int_pr                   <<- dados_int_pr[c(1:399),]









